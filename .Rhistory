str_clean <- function(df, x, dict, str.sep = NULL) {
#Retrieve index of selected column (this primarily servees for ease of use later on):
if (is.character(x)) {
col.ind <- which(names(df) == x)
} else {
col.ind <- x
}
#Vectorize string column
str_vec <- tolower(as.character(df[, col.ind]))
n.vec <- length(str_vec)
#Split strings if needed based on str.sep value. str_vec is made into a string for consistency.
if (!is.null(str.sep)) {
str_list <- strsplit(str_vec, str.sep) #Each row becomes a vector of split strings.
} else {
str_list <- str_vec
}
#Dictionary variables
keys <- names(dict)
n.keys <- length(keys)
#Output list and uncleaned information.
result_list <- vector("list", n.vec) #result_list is an empty vector that contains both cleaned and uncleaned string values.
n.no_match <- 0 #Count uncleaned string data.
no_match.ind <- list() #Named list containing uncleaned strings and the row numbers they appear in.
for (i in seq_along(str_list)) {
items <- trimws(str_list[[i]], which = "both") #Trim leading white spaces
result <- c()
#For each entry in items
for (entry in items) {
found_match <- FALSE #This is necessary for the for loop to stop once a match key is found
for (j in seq_along(dict)) {
#If entry matches a synonym replace the original string with the key.
if (entry %in% dict[[j]]) {
result <- c(result, keys[j])
found_match <- TRUE
break
}
}
if(!found_match) {
result <- c(result, entry)
n.no_match <- n.no_match + 1
no_match.ind[[entry]] <- c(no_match.ind[[entry]], i)
}
}
result_list[[i]] <- result
}
#Mutate data frame to include cleaned data next to raw data.
#Since result_list is a list item, I needed to use I() to ensure each element is a vector. The decision to do so was necessary in order for the function to complete.
df <- append(df, list(cleaned = I(result_list)), after = col.ind)
df <- as.data.frame(df)
#Uncleaned information:
if(n.no_match > 0) {
warning(paste("There were", n.no_match), "string values that were uncleaned. Please check your dictionary and the raw data.\nHere are the unmatched strings:")
for(name in names(no_match.ind)) {
message(paste0("", name, " -> rows: ", paste(no_match.ind[[name]], collapse = ", ")))
}
message("You can refer to the list of unmatched strings at no_match.ind in your global environment.")
}
#By setting no_match.ind into the global environment it allows the user to utilize the information directly for continued cleaning purposes.
assign("no_match.ind", no_match.ind, envir = .GlobalEnv)
return(df)
}
?
}
