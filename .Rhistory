str_find <- function(df,x,k.word,case.sensitive = T) {
str_vec <- df[,x]
#If word is not case sensitive
if(case.sensitive == F) {
str_vec <- tolower(str_vec)
k.word <- tolower(k.word)
#Vector that contains the index of the key word
str_ind <- which(str_vec == k.word)
#Dataframe of rows that contains the keyword
str_found <- df[str_ind,]
} else {
str_ind <- which(str_vec == k.word)
str_found <- df[str_ind,]
}
#Message notifying user that it was not found.
if(nrow(str_found) == 0) {
message("That string value could not be found. ")
} else {
message(paste("Found", nrow(str_found), "instances", sep=" "))
return(str_found)
}
}
