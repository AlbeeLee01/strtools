# 1. Setup the data (using iris Species as the example)
t <- iris[, 'Species']
total_obs <- length(t)
uni_vec <- unique(t)
num_uni <- length(uni_vec)
# 2. Initialize the matrix with NA
# We only need as many rows as there are UNIQUE strings
res.mat <- matrix(NA, nrow = num_uni, ncol = 2)
# 3. Nested Loop Logic
for(i in 1:num_uni) {
# Reset the counter for each NEW unique string
current_count <- 0
# Inner loop: Scan the entire dataset
for(j in 1:total_obs) {
if(t[j] == uni_vec[i]) {
current_count <- current_count + 1
}
}
# After scanning all rows for the current string, save to the matrix
res.mat[i, 1] <- current_count
res.mat[i, 2] <- current_count / total_obs
}
