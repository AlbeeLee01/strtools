####MIDTERM PROBLEM:
Lab.Ttest <- function(df, x, r = 4, alt = "two.sided", mu0 , CI.level = 0.95,...) {
#Create vector to be used.
v <- df[,x]
m <- mean(v,na.rm = TRUE)
#Create message:
paste("You are running a", alt, "t test against a null hypothesis of", "H0:", mu0, sep = " ")
#Histogram:
hist(v, ylab = "Frequency", xlab = x, ...)
abline(v = m, col = "red")
##### Named list:  #####
#Sample.size:
n <- length(v)
n.NA <- subset(v, is.na(v))
NA.prop <- n.NA/n
sample.inf <- round(c(N = n, Missing = n.NA, Percent_Missing = NA.prop), r)
#Ttest:
test <- t.test(v, alternative = alt, mu = mu0, conf.level = CI.level, ...)
#Sample.mean:
sample.mean <- m
#TestStatistic
test.stat <- round(test$estimate, 2)
#P.value:
p.val <- round(test$p.value, 2)
#ConfInt:
conf.int <- round(test$conf.int,2)
#Make Ttest list:
T_Test_Info <- list(SampleMean = sample.mean, TestStatistic = test.stat, Pvalue = p.val, ConfInt = conf.int)
#Decision:
mu <- 1- CI.level
if(p.val < mu ) {
decision <- paste("Since p-value =", p.val, "we reject the null hypothesis")
} else {
decision <- paste("Since p-value =", p.val, "we fail to reject the null hypothesis")
}
#ConfInt:
confint <- paste("We are", 1-CI.level, "%", " that the interval", conf.int[1], "to", conf.int[2], "contains the true mean of", x)
return(list(Sample_Size_Info = samp.info, T_Test_Info = T_Test_Info, Data = v))
}
Lab.Ttest(df=airquality, x="Solar.R", mu0=200)
